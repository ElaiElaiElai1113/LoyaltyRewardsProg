{
  "name": "pinas-rewards",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "build:budget": "node scripts/check-build-budgets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "native:sync": "npm run build && cap sync",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "test": "tsc -p tsconfig.tests.json && node .tmp-tests/tests/run-tests.js",
    "test:unit": "vitest run src",
    "test:e2e": "node scripts/run-playwright-local.mjs",
    "test:e2e:doctor": "node scripts/check-e2e-readiness.mjs",
    "test:e2e:hosted-safe": "node scripts/run-playwright-local.mjs tests/e2e/hosted-safe.spec.ts --workers=1",
    "test:e2e:ci": "node scripts/run-playwright-local.mjs tests/e2e/public.spec.ts tests/e2e/platform-guide.spec.ts tests/e2e/tenants.spec.ts tests/e2e/accessibility.spec.ts --workers=2",
    "test:e2e:quality": "node scripts/run-playwright-local.mjs tests/e2e/performance-accessibility.spec.ts --workers=1",
    "test:playwright": "node scripts/run-playwright-local.mjs",
    "test:e2e:workflows": "node scripts/run-playwright-local.mjs --workers=1",
    "test:e2e:acceptance": "node scripts/run-playwright-local.mjs tests/e2e/customer.spec.ts tests/e2e/business-owner.spec.ts tests/e2e/business-staff.spec.ts tests/e2e/admin.spec.ts tests/e2e/referrals.spec.ts tests/e2e/onboarding.spec.ts tests/e2e/gift-cards.spec.ts tests/e2e/rewards-redemption.spec.ts tests/e2e/agreements.spec.ts --workers=1",
    "test:referrals": "node scripts/run-playwright-local.mjs tests/e2e/referrals.spec.ts",
    "test:onboarding": "node scripts/run-playwright-local.mjs tests/e2e/onboarding.spec.ts",
    "test:gift-cards": "node scripts/run-playwright-local.mjs tests/e2e/gift-cards.spec.ts",
    "test:rewards": "node scripts/run-playwright-local.mjs tests/e2e/rewards-redemption.spec.ts",
    "test:agreements": "node scripts/run-playwright-local.mjs tests/e2e/agreements.spec.ts",
    "test:guide": "node scripts/run-guide-playwright.mjs",
    "test:responsive": "node scripts/audit-responsive.mjs",
    "test:load": "node scripts/run-playwright-local.mjs tests/e2e/load.spec.ts",
    "test:tenant-security": "node scripts/run-playwright-local.mjs tests/e2e/tenant-security.spec.ts --workers=1",
    "test:tenant-console": "node scripts/run-playwright-local.mjs tests/e2e/tenant-console-accessibility.spec.ts --workers=1",
    "validate:tenant-import": "node scripts/validate-tenant-import.mjs",
    "audit:tenant-branding": "node scripts/audit-tenant-branding.mjs",
    "assets:pinas-qr": "node scripts/generate-pinas-qr.mjs",
    "qa:reset-passwords": "node scripts/reset-e2e-account-passwords.mjs",
    "test:tenant-tools": "node scripts/validate-tenant-tooling.mjs",
    "test:migration-contracts": "node scripts/validate-tenant-migration-contracts.mjs",
    "test:deployment-routing": "node scripts/validate-deployment-routing.mjs",
    "test:image-delivery": "node scripts/check-image-delivery.mjs",
    "test:email-readiness": "node scripts/validate-email-readiness.mjs",
    "test:operations-readiness": "node scripts/validate-operations-readiness.mjs",
    "test:tenant-packages": "node scripts/validate-tenant-packages.mjs",
    "test:mobile-readiness": "node scripts/validate-mobile-readiness.mjs",
    "ops:migrations:validate": "node scripts/validate-migration-release.mjs",
    "ops:monitor": "node scripts/monitor-production.mjs",
    "ops:launch:evidence": "node scripts/generate-launch-readiness.mjs",
    "ops:backup:retention": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/enforce-backup-retention.ps1",
    "ops:user:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-linked-user-data.ps1",
    "ops:tenant:package": "node scripts/create-tenant-migration-package.mjs",
    "ops:tenant:reconcile": "node scripts/reconcile-tenant-exports.mjs",
    "ops:tenant:dry-run": "node scripts/dry-run-tenant-import.mjs",
    "ops:domain:check": "node scripts/check-domain-readiness.mjs",
    "ops:email:preview": "node scripts/preview-tenant-emails.mjs",
    "ops:restore:rehearse": "node scripts/rehearse-backup-restore.mjs",
    "ops:release:validate": "node scripts/validate-release-environment.mjs",
    "ops:health:diagnose": "node scripts/diagnose-health-endpoint.mjs",
    "ops:launch:gates": "node scripts/run-launch-gates.mjs",
    "ops:hosted:preflight": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/hosted-launch-preflight.ps1",
    "ops:tenant:export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-linked-program.ps1",
    "ops:tenant:audit-export": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/export-linked-program-audit.ps1",
    "ops:supabase:backup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/backup-linked-supabase.ps1",
    "ops:supabase:backup:validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/validate-supabase-backup.ps1",
    "ops:supabase:reconcile": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/reconcile-linked-supabase.ps1",
    "ops:health": "node scripts/check-health.mjs",
    "ops:smoke": "node scripts/deployment-smoke.mjs",
    "test:launch": "node scripts/run-playwright-local.mjs tests/e2e/launch-checklist.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.97.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.8.0",
    "nodemailer": "^9.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-router-dom": "^7.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.8.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "supabase": "^2.93.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.6"
  }
}
