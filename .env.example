# Supabase Configuration
# Copy this file to .env and fill in your values
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_PUBLIC_SITE_URL=https://loyalty-rewards-prog.vercel.app
# Enable only after 20260729000000_program_state_usage_and_audit.sql is applied.
VITE_TENANT_STATE_RPC_ENABLED=false
# Optional structured browser event collector and deployment release identifier.
VITE_MONITORING_ENDPOINT=
VITE_APP_RELEASE=
# Temporary test-only switch. Set to false before public launch.
VITE_SHOW_PUBLIC_QA_CREDENTIALS=true

# Server-only Hostinger SMTP configuration for Vercel API routes.
# Do not prefix these with VITE_ and do not commit real passwords.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@medellinrewards.com
SMTP_PASS=replace-with-rotated-mailbox-password

# Server-only tenant provisioning and operations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Temporary RewardMe testing accounts. Remove the public credential panel before launch.
E2E_REWARDME_MEMBER_EMAIL=member@rewardme.test
E2E_REWARDME_BUSINESS_OWNER_EMAIL=owner@rewardme.test
E2E_REWARDME_BUSINESS_STAFF_EMAIL=staff@rewardme.test
E2E_REWARDME_ADMIN_EMAIL=admin@rewardsplatform.test
E2E_PASSWORD="Rewards 123!"
# Set this only when deliberately running authenticated tests against a configured project.
E2E_AUTH_ENABLED=false
